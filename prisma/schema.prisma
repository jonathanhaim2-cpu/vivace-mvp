generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Branch {
  id              String            @id @default(cuid())
  name            String
  address         String?
  phone           String?
  contactName     String?
  createdAt       DateTime          @default(now())
  orders          Order[]
  inventoryCounts InventoryCount[]
  supplierLinks   SupplierBranch[]
  wasteEntries    WasteEntry[]
  standardSuggestions OrderStandardSuggestion[]
  exceptionalItems    ExceptionalItem[]
  cutoffReminders     OrderCutoffReminder[]
  userLinks       UserBranch[]
  invoicePhotos   InvoicePhoto[]
}

model Supplier {
  id                       String    @id @default(cuid())
  name                     String
  taxId                    String?
  agentName                String?
  agentPhone               String?
  whatsappPhone            String
  driverName               String?
  address                  String?
  deliveryPointNumber      String?
  documentType             String
  deliveryDays             String
  orderDays                String    @default("[]")
  orderCutoffTime          String
  reminderHoursBefore      Int       @default(2)
  weeklyBudgetIls          Float?
  minimumOrderIls          Float?
  notes                    String?
  defaultCategoryId        String?
  defaultCategory          ProductCategory? @relation(fields: [defaultCategoryId], references: [id])
  active                   Boolean   @default(true)
  paymentTerms             String?
  paymentMethod            String?
  accountingPhone          String?
  accountingEmail          String?
  partnerName              String?
  partnerPercent           Float?
  plantsCouncilUrl         String?
  plantsCouncilDiscountPct Float?
  plantsCouncilRelevant    Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  products                 Product[]
  orders                   Order[]
  branchLinks              SupplierBranch[]
  priceLists               PriceList[]
  apMonths                 SupplierApMonth[]
  exceptionalItems         ExceptionalItem[]
  cutoffReminders          OrderCutoffReminder[]
}

model SupplierBranch {
  supplierId          String
  branchId            String
  whatsappPhone       String?
  agentName           String?
  agentPhone          String?
  accountingPhone     String?
  accountingEmail     String?
  taxId               String?
  address             String?
  deliveryPointNumber String?
  deliveryDays        String?
  orderDays           String?
  orderCutoffTime     String?
  notes               String?
  supplier            Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branch              Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@id([supplierId, branchId])
}

model PriceList {
  id         String          @id @default(cuid())
  supplierId String
  supplier   Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  kind       String
  name       String
  items      PriceListItem[]
  @@unique([supplierId, kind])
}

model PriceListItem {
  id              String    @id @default(cuid())
  priceListId     String
  priceList       PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitPrice       Float
  discountPercent Float     @default(0)
  rebatePercent   Float     @default(0)
  plusPercent     Float     @default(0)
  @@unique([priceListId, productId])
}

model Product {
  id              String      @id @default(cuid())
  supplierId      String
  supplier        Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name            String
  sku             String?
  notes           String?
  categoryId      String?
  category        ProductCategory? @relation(fields: [categoryId], references: [id])
  stockStandard   Float
  agreedPrice     Float
  discountPercent Float       @default(0)
  vatIncluded     Boolean     @default(true)
  cartonToBags    Int?
  bagsToUnits     Int?
  packagingNotes  String?
  documentType           String?
  networkRebatePercent   Float       @default(0)
  networkPlusPercent     Float       @default(0)
  plantsCouncilRelevant  Boolean?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  orderLines             OrderLine[]
  inventoryLines         InventoryCountLine[]
  dishComponents         DishComponent[]
  priceListItems         PriceListItem[]
  wasteEntries           WasteEntry[]
  standardSuggestions    OrderStandardSuggestion[]
}

model Order {
  id                  String            @id @default(cuid())
  supplierId          String
  supplier            Supplier          @relation(fields: [supplierId], references: [id])
  branchId            String
  branch              Branch            @relation(fields: [branchId], references: [id])
  status              String
  notesForDriver      String?
  whatsappStatus      String            @default("PENDING")
  whatsappSentAt      DateTime?
  whatsappDeliveredAt DateTime?
  whatsappReadAt      DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lines               OrderLine[]
  receipt             GoodsReceipt?
  exceptionalItems    ExceptionalItem[]
}

model OrderLine {
  id              String            @id @default(cuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  qty             Float
  unitPrice       Float
  discountPercent Float             @default(0)
  receiptLine     GoodsReceiptLine?
}

model Account {
  id        String   @id
  name      String
  kind      String
  parentId  String?
  parent    Account?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Account[] @relation("AccountHierarchy")
  sortOrder Int
  receipts  GoodsReceipt[]
  photos    InvoicePhoto[]
  productCategories ProductCategory[]
}

model ProductCategory {
  id          String   @id
  name        String
  parentId    String?
  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProductCategory[] @relation("CategoryTree")
  sortOrder   Int      @default(0)
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  targetPercent Float?
  products    Product[]
  suppliers   Supplier[]
}

model GoodsReceipt {
  id                    String             @id @default(cuid())
  orderId               String             @unique
  order                 Order              @relation(fields: [orderId], references: [id])
  status                String
  notes                 String?
  accountId             String?
  account               Account?           @relation(fields: [accountId], references: [id])
  forwardedToAccountant Boolean            @default(false)
  forwardedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  lines                 GoodsReceiptLine[]
  photos                InvoicePhoto[]
  exceptionalItems      ExceptionalItem[]
}

model GoodsReceiptLine {
  id                String       @id @default(cuid())
  goodsReceiptId    String
  goodsReceipt      GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  orderLineId       String       @unique
  orderLine         OrderLine    @relation(fields: [orderLineId], references: [id])
  receivedQty       Float
  invoicePrice      Float
  missing           Boolean      @default(false)
  wrongPrice        Boolean      @default(false)
  priceChangeStatus String?
  billedAs          String?
  qtyMismatch       Boolean      @default(false)
  exceptionalItems  ExceptionalItem[]
}

model InvoicePhoto {
  id             String        @id @default(cuid())
  goodsReceiptId String?
  goodsReceipt   GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  /// Branch this invoice counts toward for purchase-vs-turnover, even without an Order.
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  accountId      String?
  account        Account?      @relation(fields: [accountId], references: [id])
  amountIls      Float?
  voiceNoteText  String?
  fileName       String
  originalName   String
  mimeType       String
  contentHash    String?
  isDuplicate    Boolean       @default(false)
  duplicateStatus String?
  duplicateOfId  String?
  duplicateOf    InvoicePhoto? @relation("InvoicePhotoDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates     InvoicePhoto[] @relation("InvoicePhotoDuplicates")
  periodMonth    String?
  source         String        @default("MANUAL")
  classifiedAt   DateTime?
  createdAt      DateTime      @default(now())
  paid           Boolean       @default(false)
  paidAt         DateTime?
  sentToAccountant Boolean     @default(false)
  aiSupplierName String?
  aiInvoiceDate  String?
  aiTotalIls     Float?
  aiAccountId    String?
  aiConfidence   Float?
  aiReason       String?
  aiStatus       String?

  @@index([contentHash])
  @@index([isDuplicate])
  @@index([branchId])
}

/// Dedup for IMAP intake: same Message-ID + attachment hash is never imported twice.
model InvoiceMailImport {
  id             String   @id @default(cuid())
  messageId      String
  contentHash    String
  uid            Int?
  originalName   String   @default("")
  invoicePhotoId String?
  createdAt      DateTime @default(now())

  @@unique([messageId, contentHash])
  @@index([messageId])
}

model InventoryCount {
  id          String               @id @default(cuid())
  branchId    String
  branch      Branch               @relation(fields: [branchId], references: [id])
  countedOn   DateTime
  status      String
  kind        String               @default("SPOT")
  periodMonth String?
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  lines       InventoryCountLine[]
}

model InventoryCountLine {
  id         String         @id @default(cuid())
  countId    String
  count      InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId  String
  product    Product        @relation(fields: [productId], references: [id])
  countedQty Float
}

model Dish {
  id                  String          @id @default(cuid())
  name                String
  kind                String
  sellPrice           Float?
  standardCostPercent Float           @default(28)
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  components          DishComponent[] @relation("DishHasComponents")
  usedIn              DishComponent[] @relation("UsedAsComponent")
}

model DishComponent {
  id              String  @id @default(cuid())
  dishId          String
  dish            Dish    @relation("DishHasComponents", fields: [dishId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  componentDishId String?
  componentDish   Dish?   @relation("UsedAsComponent", fields: [componentDishId], references: [id])
  qty             Float
  notes           String?
}

model RecurringLine {
  id        String  @id @default(cuid())
  name      String
  kind      String
  cadence   String
  amountIls Float
  accountId String?
  notes     String?
}

model WasteEntry {
  id             String   @id @default(cuid())
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  occurredOn     DateTime
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  qty            Float    @default(0)
  estimatedCost  Float    @default(0)
  notes          String?
  voiceFileName  String?
  createdAt      DateTime @default(now())
}

/// One conversation. Additive: existing ChatMessage rows stay valid with nullable threadId.
model ChatThread {
  id        String        @id @default(cuid())
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  /// True for the one-time archive of pre-thread history («קודם»).
  archived  Boolean       @default(false)
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  role      String
  content   String
  path      String?
  createdAt DateTime    @default(now())
  /// Optional for Railway `db push` on existing SQLite rows; backfilled at runtime.
  threadId  String?
  thread    ChatThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model AppSetting {
  key   String @id
  value String
}

model User {
  id           String       @id @default(cuid())
  name         String
  username     String       @unique
  passwordHash String
  role         String
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  branches     UserBranch[]
}

model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@id([userId, branchId])
}

model RolePermission {
  role    String
  key     String
  allowed Boolean @default(false)
  @@id([role, key])
}

/// Durable who/when/what for critical mutations. Actor fields are copied at write time
/// so historical rows survive user rename/delete. actorUserId is not a FK (dev session
/// and deleted users are still valid actors).
model AuditLog {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  actorUserId   String?
  actorUsername String
  actorName     String
  action        String
  entityType    String
  entityId      String
  summary       String
  meta          Json?
  @@index([createdAt])
  @@index([action])
  @@index([actorUsername])
  @@index([entityType, entityId])
}

model OrderStandardSuggestion {
  id                String   @id @default(cuid())
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  periodMonth       String
  startCountId      String?
  endCountId        String?
  startQty          Float
  orderedQty        Float
  endQty            Float
  wasteQty          Float
  consumptionQty    Float
  suggestedStandard Float
  currentStandard   Float
  status            String   @default("PENDING")
  notes             String?
  createdAt         DateTime @default(now())
  @@unique([branchId, productId, periodMonth])
}

model SupplierApMonth {
  id                   String    @id @default(cuid())
  supplierId           String
  supplier             Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  month                String
  kartesetRequestedAt  DateTime?
  kartesetStatus       String?
  amountDue            Float     @default(0)
  approvedForPayment   Boolean   @default(false)
  payMethod            String?
  notes                String?
  @@unique([supplierId, month])
}

/// Open credit requests, shortages without credit, and "on the way" goods.
model ExceptionalItem {
  id                 String            @id @default(cuid())
  kind               String
  status             String            @default("OPEN")
  title              String
  amountIls          Float             @default(0)
  orderedQty         Float
  receivedQty        Float
  productName        String
  notes              String?
  goodsReceiptId     String?
  goodsReceipt       GoodsReceipt?     @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  goodsReceiptLineId String?
  goodsReceiptLine   GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id], onDelete: SetNull)
  orderId            String?
  order              Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId         String
  supplier           Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branchId           String
  branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  resolvedAt         DateTime?
}

model OrderCutoffReminder {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dateKey    String
  notifiedAt DateTime @default(now())
  @@unique([supplierId, branchId, dateKey])
}
