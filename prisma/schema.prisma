generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id              String            @id @default(cuid())
  name            String
  address         String?
  phone           String?
  contactName     String?
  createdAt       DateTime          @default(now())
  orders          Order[]
  inventoryCounts InventoryCount[]
  supplierLinks   SupplierBranch[]
  wasteEntries    WasteEntry[]
  standardSuggestions OrderStandardSuggestion[]
  exceptionalItems    ExceptionalItem[]
  cutoffReminders     OrderCutoffReminder[]
  userLinks       UserBranch[]
  invoicePhotos   InvoicePhoto[]
  aiSuggestedPhotos InvoicePhoto[] @relation("InvoiceAiBranch")
  supplierRequests    SupplierRequest[]
}

model Supplier {
  id                       String    @id @default(cuid())
  name                     String
  taxId                    String?
  agentName                String?
  agentPhone               String?
  whatsappPhone            String
  driverName               String?
  address                  String?
  deliveryPointNumber      String?
  documentType             String
  deliveryDays             String
  orderDays                String    @default("[]")
  orderCutoffTime          String
  reminderHoursBefore      Int       @default(2)
  weeklyBudgetIls          Float?
  minimumOrderIls          Float?
  notes                    String?
  defaultCategoryId        String?
  defaultCategory          ProductCategory? @relation(fields: [defaultCategoryId], references: [id])
  active                   Boolean   @default(true)
  paymentTerms             String?
  paymentMethod            String?
  /// 1–28: day of month the card/transfer is charged (e.g. 15 for אשראי).
  paymentChargeDay         Int?
  card1Label               String?
  card2Label               String?
  accountingPhone          String?
  accountingEmail          String?
  partnerName              String?
  partnerPercent           Float?
  plantsCouncilUrl         String?
  plantsCouncilDiscountPct Float?
  plantsCouncilRelevant    Boolean   @default(false)
  /// ספק הזמנות — only these appear in goods receiving and the new-order supplier grid.
  isOrderable              Boolean   @default(false)
  /// Network-office annual purchase target (ILS), edited inline on the suppliers list.
  annualPurchaseTargetIls  Float?
  paymentCardId            String?
  paymentCard              PaymentCard? @relation(fields: [paymentCardId], references: [id], onDelete: SetNull)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  products                 Product[]
  orders                   Order[]
  branchLinks              SupplierBranch[]
  priceLists               PriceList[]
  apMonths                 SupplierApMonth[]
  exceptionalItems         ExceptionalItem[]
  cutoffReminders          OrderCutoffReminder[]
  recurringLines           RecurringLine[]
  supplierRequests         SupplierRequest[]
}

model SupplierBranch {
  supplierId          String
  branchId            String
  whatsappPhone       String?
  agentName           String?
  agentPhone          String?
  accountingPhone     String?
  accountingEmail     String?
  taxId               String?
  address             String?
  deliveryPointNumber String?
  deliveryDays        String?
  orderDays           String?
  orderCutoffTime     String?
  notes               String?
  driverName          String?
  /// FRANCHISEE | NETWORK — which price list this branch uses.
  catalogKind         String?
  paymentMethod       String?
  paymentChargeDay    Int?
  supplier            Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branch              Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@id([supplierId, branchId])
}

model PriceList {
  id         String          @id @default(cuid())
  supplierId String
  supplier   Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  kind       String
  name       String
  items      PriceListItem[]
  @@unique([supplierId, kind])
}

model PriceListItem {
  id              String    @id @default(cuid())
  priceListId     String
  priceList       PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitPrice       Float
  discountPercent Float     @default(0)
  rebatePercent   Float     @default(0)
  plusPercent     Float     @default(0)
  @@unique([priceListId, productId])
}

model Product {
  id              String      @id @default(cuid())
  supplierId      String
  supplier        Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name            String
  sku             String?
  notes           String?
  categoryId      String?
  category        ProductCategory? @relation(fields: [categoryId], references: [id])
  stockStandard   Float
  agreedPrice     Float
  discountPercent Float       @default(0)
  vatIncluded     Boolean     @default(true)
  cartonToBags    Int?
  bagsToUnits     Int?
  packagingNotes  String?
  documentType           String?
  networkRebatePercent   Float       @default(0)
  networkPlusPercent     Float       @default(0)
  plantsCouncilRelevant  Boolean?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  orderLines             OrderLine[]
  inventoryLines         InventoryCountLine[]
  dishComponents         DishComponent[]
  priceListItems         PriceListItem[]
  wasteEntries           WasteEntry[]
  standardSuggestions    OrderStandardSuggestion[]
}

model Order {
  id                  String            @id @default(cuid())
  supplierId          String
  supplier            Supplier          @relation(fields: [supplierId], references: [id])
  branchId            String
  branch              Branch            @relation(fields: [branchId], references: [id])
  status              String
  notesForDriver      String?
  whatsappStatus      String            @default("PENDING")
  whatsappSentAt      DateTime?
  whatsappDeliveredAt DateTime?
  whatsappReadAt      DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lines               OrderLine[]
  receipt             GoodsReceipt?
  exceptionalItems    ExceptionalItem[]
  supplierRequests    SupplierRequest[]
}

model OrderLine {
  id              String            @id @default(cuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  qty             Float
  unitPrice       Float
  discountPercent Float             @default(0)
  receiptLine     GoodsReceiptLine?
}

model Account {
  id        String   @id
  name      String
  kind      String
  parentId  String?
  parent    Account?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Account[] @relation("AccountHierarchy")
  sortOrder Int
  receipts  GoodsReceipt[]
  photos    InvoicePhoto[]
  productCategories ProductCategory[]
}

model ProductCategory {
  id          String   @id
  name        String
  parentId    String?
  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProductCategory[] @relation("CategoryTree")
  sortOrder   Int      @default(0)
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  targetPercent Float?
  products    Product[]
  suppliers   Supplier[]
}

model GoodsReceipt {
  id                    String             @id @default(cuid())
  orderId               String             @unique
  order                 Order              @relation(fields: [orderId], references: [id])
  status                String
  notes                 String?
  accountId             String?
  account               Account?           @relation(fields: [accountId], references: [id])
  forwardedToAccountant Boolean            @default(false)
  forwardedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  lines                 GoodsReceiptLine[]
  photos                InvoicePhoto[]
  exceptionalItems      ExceptionalItem[]
  supplierRequests      SupplierRequest[]
}

model GoodsReceiptLine {
  id                String       @id @default(cuid())
  goodsReceiptId    String
  goodsReceipt      GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  orderLineId       String       @unique
  orderLine         OrderLine    @relation(fields: [orderLineId], references: [id])
  receivedQty       Float
  invoicePrice      Float
  missing           Boolean      @default(false)
  wrongPrice        Boolean      @default(false)
  priceChangeStatus String?
  billedAs          String?
  qtyMismatch       Boolean      @default(false)
  exceptionalItems  ExceptionalItem[]
}

model InvoicePhoto {
  id             String        @id @default(cuid())
  goodsReceiptId String?
  goodsReceipt   GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  /// Branch this invoice counts toward for purchase-vs-turnover, even without an Order.
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  accountId      String?
  account        Account?      @relation(fields: [accountId], references: [id])
  amountIls      Float?
  voiceNoteText  String?
  fileName       String
  originalName   String
  mimeType       String
  contentHash    String?
  isDuplicate    Boolean       @default(false)
  duplicateStatus String?
  duplicateOfId  String?
  duplicateOf    InvoicePhoto? @relation("InvoicePhotoDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates     InvoicePhoto[] @relation("InvoicePhotoDuplicates")
  periodMonth    String?
  source         String        @default("MANUAL")
  classifiedAt   DateTime?
  createdAt      DateTime      @default(now())
  paid           Boolean       @default(false)
  paidAt         DateTime?
  sentToAccountant Boolean     @default(false)
  /// Snapshot of amountIls before a paid-toggle so «לא שולם» can restore it.
  originalAmountIls Float?
  vatIncluded    Boolean       @default(true)
  amountExVat    Float?
  vatAmount      Float?
  /// INVOICE | CREDIT_NOTE | RECEIPT | DELIVERY_NOTE | STATEMENT | UNKNOWN. String so Railway `db push` stays additive.
  documentType   String        @default("UNKNOWN")
  aiDocumentType String?
  aiSupplierName String?
  aiInvoiceDate  String?
  aiTotalIls     Float?
  aiAccountId    String?
  aiConfidence   Float?
  aiReason       String?
  aiStatus       String?
  /// Suggested branch from the document; not applied until confirm/classify.
  aiBranchId     String?
  aiBranch       Branch?       @relation("InvoiceAiBranch", fields: [aiBranchId], references: [id], onDelete: SetNull)
  /// True when AI inferred HQ/consulting with no site — confirm should default to רשת.
  aiNetworkExpense Boolean     @default(false)
  /// APPROVED rows enter reports. EMAIL intake stays PENDING until a person approves.
  approvalStatus String        @default("APPROVED")
  expenseLink    InvoiceExpenseLink?
  creditRequests SupplierRequest[] @relation("RequestCreditNote")

  @@index([contentHash])
  @@index([approvalStatus])
  @@index([isDuplicate])
  @@index([branchId])
  @@index([aiBranchId])
}

/// Dedup for IMAP intake: same Message-ID + attachment hash is never imported twice.
model InvoiceMailImport {
  id             String   @id @default(cuid())
  messageId      String
  contentHash    String
  uid            Int?
  mailboxUser    String   @default("")
  originalName   String   @default("")
  invoicePhotoId String?
  createdAt      DateTime @default(now())

  @@unique([messageId, contentHash])
  @@index([messageId])
  @@index([mailboxUser, uid])
}

model InventoryCount {
  id          String               @id @default(cuid())
  branchId    String
  branch      Branch               @relation(fields: [branchId], references: [id])
  countedOn   DateTime
  status      String
  kind        String               @default("SPOT")
  periodMonth String?
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  lines       InventoryCountLine[]
}

model InventoryCountLine {
  id         String         @id @default(cuid())
  countId    String
  count      InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId  String
  product    Product        @relation(fields: [productId], references: [id])
  countedQty Float
}

model Dish {
  id                  String          @id @default(cuid())
  name                String
  kind                String
  sellPrice           Float?
  standardCostPercent Float           @default(28)
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  components          DishComponent[] @relation("DishHasComponents")
  usedIn              DishComponent[] @relation("UsedAsComponent")
  /// Menu tree: CATEGORY nodes (פיצות, סמול…) or DISH. Existing recipes stay DISH.
  nodeKind            String          @default("DISH")
  parentId            String?
  parent              Dish?           @relation("DishMenu", fields: [parentId], references: [id], onDelete: SetNull)
  children            Dish[]          @relation("DishMenu")
  sortOrder           Int             @default(0)
  systemKey           String?         @unique
}

model DishComponent {
  id              String  @id @default(cuid())
  dishId          String
  dish            Dish    @relation("DishHasComponents", fields: [dishId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  componentDishId String?
  componentDish   Dish?   @relation("UsedAsComponent", fields: [componentDishId], references: [id])
  qty             Float
  notes           String?
}

model RecurringLine {
  id            String  @id @default(cuid())
  name          String
  kind          String
  cadence       String
  amountIls     Float
  accountId     String?
  notes         String?
  branchId      String?
  paymentMethod String?
  chargeDay     Int?
  active        Boolean @default(true)
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// Comma-separated keywords used to auto-match incoming invoices.
  keywords      String?
  /// Manual override of expected invoices per month. Null = average of the last 3 full months.
  expectedInvoicesPerMonth Int?
  expenseLinks  InvoiceExpenseLink[]
}

model WasteEntry {
  id             String   @id @default(cuid())
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  occurredOn     DateTime
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  qty            Float    @default(0)
  estimatedCost  Float    @default(0)
  notes          String?
  voiceFileName  String?
  createdAt      DateTime @default(now())
}

/// One conversation. Additive: existing ChatMessage rows stay valid with nullable threadId.
model ChatThread {
  id        String        @id @default(cuid())
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  /// True for the one-time archive of pre-thread history («קודם»).
  archived  Boolean       @default(false)
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  role      String
  content   String
  path      String?
  createdAt DateTime    @default(now())
  /// Optional for Railway `db push` on existing SQLite rows; backfilled at runtime.
  threadId  String?
  thread    ChatThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model AppSetting {
  key   String @id
  value String
}

model User {
  id           String       @id @default(cuid())
  name         String
  username     String       @unique
  passwordHash String
  role         String
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  branches     UserBranch[]
}

model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@id([userId, branchId])
}

model RolePermission {
  role    String
  key     String
  allowed Boolean @default(false)
  @@id([role, key])
}

/// Durable who/when/what for critical mutations. Actor fields are copied at write time
/// so historical rows survive user rename/delete. actorUserId is not a FK (dev session
/// and deleted users are still valid actors).
model AuditLog {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  actorUserId   String?
  actorUsername String
  actorName     String
  action        String
  entityType    String
  entityId      String
  summary       String
  meta          Json?
  @@index([createdAt])
  @@index([action])
  @@index([actorUsername])
  @@index([entityType, entityId])
}

model OrderStandardSuggestion {
  id                String   @id @default(cuid())
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  periodMonth       String
  startCountId      String?
  endCountId        String?
  startQty          Float
  orderedQty        Float
  endQty            Float
  wasteQty          Float
  consumptionQty    Float
  suggestedStandard Float
  currentStandard   Float
  status            String   @default("PENDING")
  notes             String?
  createdAt         DateTime @default(now())
  @@unique([branchId, productId, periodMonth])
}

model SupplierApMonth {
  id                   String    @id @default(cuid())
  supplierId           String
  supplier             Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  month                String
  kartesetRequestedAt  DateTime?
  kartesetStatus       String?
  amountDue            Float     @default(0)
  approvedForPayment   Boolean   @default(false)
  payMethod            String?
  notes                String?
  @@unique([supplierId, month])
}

/// Open credit requests, shortages without credit, and "on the way" goods.
model ExceptionalItem {
  id                 String            @id @default(cuid())
  kind               String
  status             String            @default("OPEN")
  title              String
  amountIls          Float             @default(0)
  orderedQty         Float
  receivedQty        Float
  productName        String
  notes              String?
  goodsReceiptId     String?
  goodsReceipt       GoodsReceipt?     @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  goodsReceiptLineId String?
  goodsReceiptLine   GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id], onDelete: SetNull)
  orderId            String?
  order              Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId         String
  supplier           Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branchId           String
  branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  resolvedAt         DateTime?
}

model OrderCutoffReminder {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dateKey    String
  notifiedAt DateTime @default(now())
  @@unique([supplierId, branchId, dateKey])
}

/// Credit card / payment method that drives cash-flow billing days.
model PaymentCard {
  id         String            @id @default(cuid())
  name       String
  last4      String
  billingDay Int
  notes      String?
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  links      PaymentCardLink[]
  suppliers  Supplier[]
}

model PaymentCardLink {
  id         String      @id @default(cuid())
  cardId     String
  card       PaymentCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  supplierId String?
  accountId  String?
  label      String?
}

/// Goods one branch takes from another. Booked only after both sides approve.
model InterBranchTransfer {
  id             String    @id @default(cuid())
  fromBranchId   String
  toBranchId     String
  productId      String?
  title          String
  qty            Float
  unitPrice      Float
  amountIls      Float
  /// PENDING until both sides approve, then APPROVED. REJECTED is kept.
  status         String    @default("PENDING")
  /// FROM records a sale, TO records a purchase.
  initiatorSide  String
  fromApprovedAt DateTime?
  toApprovedAt   DateTime?
  periodMonth    String
  notes          String?
  createdAt      DateTime  @default(now())
}

model SupplierQuote {
  id         String              @id @default(cuid())
  supplierName String
  fileName   String?
  notes      String?
  createdAt  DateTime            @default(now())
  lines      SupplierQuoteLine[]
}

model SupplierQuoteLine {
  id           String        @id @default(cuid())
  quoteId      String
  quote        SupplierQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name         String
  offered      Float
  monthlyQty   Float         @default(0)
  monthAvg     Float?
  yearAvg      Float?
  productId    String?
}

/// Credit (בקשת זיכוי) or charge (בקשת חיוב) generated from a receiving discrepancy.
/// Stays OPEN until a credit note is matched (credits). Charges are tracked separately.
model SupplierRequest {
  id                String    @id @default(cuid())
  /// CREDIT | CHARGE
  kind              String
  /// OPEN | CLOSED
  status            String    @default("OPEN")
  supplierId        String
  supplier          Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orderId           String?
  order             Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  goodsReceiptId    String?
  goodsReceipt      GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  documentNumber    String?
  deliveryDate      DateTime?
  previewBody       String
  sentAt            DateTime?
  creditNotePhotoId String?
  creditNotePhoto   InvoicePhoto? @relation("RequestCreditNote", fields: [creditNotePhotoId], references: [id], onDelete: SetNull)
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  lines             SupplierRequestLine[]

  @@index([status, kind])
  @@index([supplierId])
  @@index([goodsReceiptId])
}

model SupplierRequestLine {
  id          String          @id @default(cuid())
  requestId   String
  request     SupplierRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productName String
  orderedQty  Float
  receivedQty Float
  unitPrice   Float?
  amountDiff  Float?
  /// NOT_ARRIVED | ARRIVED_LESS | ARRIVED_MORE
  mark        String
}

/// One invoice assigned to one fixed/variable expense. source AUTO is replaced on re-match; MANUAL sticks.
model InvoiceExpenseLink {
  id              String        @id @default(cuid())
  invoicePhotoId  String        @unique
  invoicePhoto    InvoicePhoto  @relation(fields: [invoicePhotoId], references: [id], onDelete: Cascade)
  recurringLineId String
  recurringLine   RecurringLine @relation(fields: [recurringLineId], references: [id], onDelete: Cascade)
  source          String        @default("AUTO")
  createdAt       DateTime      @default(now())

  @@index([recurringLineId])
}
