generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Supplier {
  id                  String    @id @default(cuid())
  name                String
  taxId               String?
  agentName           String?
  agentPhone          String?
  whatsappPhone       String
  driverName          String?
  documentType        String
  deliveryDays        String
  orderCutoffTime     String
  reminderHoursBefore Int       @default(2)
  weeklyBudgetIls     Float?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  products            Product[]
  orders              Order[]
}

model Product {
  id              String      @id @default(cuid())
  supplierId      String
  supplier        Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name            String
  sku             String?
  notes           String?
  stockStandard   Float
  agreedPrice     Float
  discountPercent Float       @default(0)
  vatIncluded     Boolean     @default(true)
  cartonToBags    Int?
  bagsToUnits     Int?
  packagingNotes  String?
  documentType    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderLines      OrderLine[]
}

model Order {
  id             String        @id @default(cuid())
  supplierId     String
  supplier       Supplier      @relation(fields: [supplierId], references: [id])
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id])
  status         String
  notesForDriver String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lines          OrderLine[]
  receipt        GoodsReceipt?
}

model OrderLine {
  id              String            @id @default(cuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  qty             Float
  unitPrice       Float
  discountPercent Float             @default(0)
  receiptLine     GoodsReceiptLine?
}

model GoodsReceipt {
  id                    String             @id @default(cuid())
  orderId               String             @unique
  order                 Order              @relation(fields: [orderId], references: [id])
  status                String
  notes                 String?
  expenseCategory       String?
  forwardedToAccountant Boolean            @default(false)
  forwardedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  lines                 GoodsReceiptLine[]
  photos                InvoicePhoto[]
}

model GoodsReceiptLine {
  id                String       @id @default(cuid())
  goodsReceiptId    String
  goodsReceipt      GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  orderLineId       String       @unique
  orderLine         OrderLine    @relation(fields: [orderLineId], references: [id])
  receivedQty       Float
  invoicePrice      Float
  missing           Boolean      @default(false)
  wrongPrice        Boolean      @default(false)
  priceChangeStatus String?
}

model InvoicePhoto {
  id              String        @id @default(cuid())
  goodsReceiptId  String?
  goodsReceipt    GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  expenseCategory String?
  voiceNoteText   String?
  fileName        String
  originalName    String
  mimeType        String
  createdAt       DateTime      @default(now())
}
