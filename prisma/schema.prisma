generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Branch {
  id              String            @id @default(cuid())
  name            String
  address         String?
  createdAt       DateTime          @default(now())
  orders          Order[]
  inventoryCounts InventoryCount[]
  supplierLinks   SupplierBranch[]
  wasteEntries    WasteEntry[]
}

model Supplier {
  id                       String    @id @default(cuid())
  name                     String
  taxId                    String?
  agentName                String?
  agentPhone               String?
  whatsappPhone            String
  driverName               String?
  documentType             String
  deliveryDays             String
  orderCutoffTime          String
  reminderHoursBefore      Int       @default(2)
  weeklyBudgetIls          Float?
  notes                    String?
  defaultCategoryId        String?
  defaultCategory          ProductCategory? @relation(fields: [defaultCategoryId], references: [id])
  active                   Boolean   @default(true)
  paymentTerms             String?
  paymentMethod            String?
  accountingPhone          String?
  accountingEmail          String?
  partnerName              String?
  partnerPercent           Float?
  plantsCouncilUrl         String?
  plantsCouncilDiscountPct Float?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  products                 Product[]
  orders                   Order[]
  branchLinks              SupplierBranch[]
  priceLists               PriceList[]
  apMonths                 SupplierApMonth[]
}

model SupplierBranch {
  supplierId String
  branchId   String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@id([supplierId, branchId])
}

model PriceList {
  id         String          @id @default(cuid())
  supplierId String
  supplier   Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  kind       String
  name       String
  items      PriceListItem[]
  @@unique([supplierId, kind])
}

model PriceListItem {
  id              String    @id @default(cuid())
  priceListId     String
  priceList       PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitPrice       Float
  discountPercent Float     @default(0)
  rebatePercent   Float     @default(0)
  plusPercent     Float     @default(0)
  @@unique([priceListId, productId])
}

model Product {
  id              String      @id @default(cuid())
  supplierId      String
  supplier        Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name            String
  sku             String?
  notes           String?
  categoryId      String?
  category        ProductCategory? @relation(fields: [categoryId], references: [id])
  stockStandard   Float
  agreedPrice     Float
  discountPercent Float       @default(0)
  vatIncluded     Boolean     @default(true)
  cartonToBags    Int?
  bagsToUnits     Int?
  packagingNotes  String?
  documentType           String?
  networkRebatePercent   Float       @default(0)
  networkPlusPercent     Float       @default(0)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  orderLines             OrderLine[]
  inventoryLines         InventoryCountLine[]
  dishComponents         DishComponent[]
  priceListItems         PriceListItem[]
  wasteEntries           WasteEntry[]
}

model Order {
  id             String        @id @default(cuid())
  supplierId     String
  supplier       Supplier      @relation(fields: [supplierId], references: [id])
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id])
  status         String
  notesForDriver String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lines          OrderLine[]
  receipt        GoodsReceipt?
}

model OrderLine {
  id              String            @id @default(cuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  qty             Float
  unitPrice       Float
  discountPercent Float             @default(0)
  receiptLine     GoodsReceiptLine?
}

model Account {
  id        String   @id
  name      String
  kind      String
  parentId  String?
  parent    Account?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Account[] @relation("AccountHierarchy")
  sortOrder Int
  receipts  GoodsReceipt[]
  photos    InvoicePhoto[]
  productCategories ProductCategory[]
}

model ProductCategory {
  id          String   @id
  name        String
  parentId    String?
  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProductCategory[] @relation("CategoryTree")
  sortOrder   Int      @default(0)
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
  targetPercent Float?
  products    Product[]
  suppliers   Supplier[]
}

model GoodsReceipt {
  id                    String             @id @default(cuid())
  orderId               String             @unique
  order                 Order              @relation(fields: [orderId], references: [id])
  status                String
  notes                 String?
  accountId             String?
  account               Account?           @relation(fields: [accountId], references: [id])
  forwardedToAccountant Boolean            @default(false)
  forwardedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  lines                 GoodsReceiptLine[]
  photos                InvoicePhoto[]
}

model GoodsReceiptLine {
  id                String       @id @default(cuid())
  goodsReceiptId    String
  goodsReceipt      GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  orderLineId       String       @unique
  orderLine         OrderLine    @relation(fields: [orderLineId], references: [id])
  receivedQty       Float
  invoicePrice      Float
  missing           Boolean      @default(false)
  wrongPrice        Boolean      @default(false)
  priceChangeStatus String?
}

model InvoicePhoto {
  id             String        @id @default(cuid())
  goodsReceiptId String?
  goodsReceipt   GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  accountId      String?
  account        Account?      @relation(fields: [accountId], references: [id])
  amountIls      Float?
  voiceNoteText  String?
  fileName       String
  originalName   String
  mimeType       String
  periodMonth    String?
  source         String        @default("MANUAL")
  classifiedAt   DateTime?
  createdAt      DateTime      @default(now())
  paid           Boolean       @default(false)
  paidAt         DateTime?
  sentToAccountant Boolean     @default(false)
  aiSupplierName String?
  aiInvoiceDate  String?
  aiTotalIls     Float?
  aiAccountId    String?
  aiConfidence   Float?
  aiReason       String?
  aiStatus       String?
}

model InventoryCount {
  id        String               @id @default(cuid())
  branchId  String
  branch    Branch               @relation(fields: [branchId], references: [id])
  countedOn DateTime
  status    String
  notes     String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  lines     InventoryCountLine[]
}

model InventoryCountLine {
  id         String         @id @default(cuid())
  countId    String
  count      InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId  String
  product    Product        @relation(fields: [productId], references: [id])
  countedQty Float
}

model Dish {
  id                  String          @id @default(cuid())
  name                String
  kind                String
  sellPrice           Float?
  standardCostPercent Float           @default(28)
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  components          DishComponent[] @relation("DishHasComponents")
  usedIn              DishComponent[] @relation("UsedAsComponent")
}

model DishComponent {
  id              String  @id @default(cuid())
  dishId          String
  dish            Dish    @relation("DishHasComponents", fields: [dishId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  componentDishId String?
  componentDish   Dish?   @relation("UsedAsComponent", fields: [componentDishId], references: [id])
  qty             Float
  notes           String?
}

model RecurringLine {
  id        String  @id @default(cuid())
  name      String
  kind      String
  cadence   String
  amountIls Float
  accountId String?
  notes     String?
}

model WasteEntry {
  id             String   @id @default(cuid())
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  occurredOn     DateTime
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  qty            Float    @default(0)
  estimatedCost  Float    @default(0)
  notes          String?
  voiceFileName  String?
  createdAt      DateTime @default(now())
}

model AppSetting {
  key   String @id
  value String
}

model SupplierApMonth {
  id                   String    @id @default(cuid())
  supplierId           String
  supplier             Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  month                String
  kartesetRequestedAt  DateTime?
  kartesetStatus       String?
  amountDue            Float     @default(0)
  approvedForPayment   Boolean   @default(false)
  payMethod            String?
  notes                String?
  @@unique([supplierId, month])
}
