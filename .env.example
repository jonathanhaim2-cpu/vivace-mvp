# SQLite file (local / single-server Railway/Fly with a volume)
DATABASE_URL="file:./dev.db"

# Shared login. If unset, the app stays open for local `npm run dev`.
APP_PASSWORD=""
# Optional second password for Roi (same or different).
APP_PASSWORD_ROI=""
# Recommended in production so rotating passwords does not mint a new session secret.
AUTH_SECRET=""

# AI: prefer Gemini Flash if a Google key is set, else OpenAI.
# AI_PROVIDER=google
# AI_PROVIDER=openai
GOOGLE_GENERATIVE_AI_API_KEY=""
# GEMINI_API_KEY=""
OPENAI_API_KEY=""
# Soft monthly cap in USD. Analysis stops and falls back to manual classify.
# Same keys power invoice vision, receipt scan, and the in-app chat drawer.
# AI_MONTHLY_BUDGET_USD=5
# AI_USD_PER_CALL=0.002
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_VISION_MODEL=gpt-4o-mini

# Persistent upload directory on a volume (defaults to public/uploads)
# UPLOAD_DIR=/data/uploads

# Real Zest catalog (כהן, ירקות, קפה, תפוזזה, יין). Default ON unless false/0/no.
# SEED_REAL=
# Optional. If true/1/yes, seed the old Tnuva/Herzliya demo catalog instead.
# SEED_DEMO=
