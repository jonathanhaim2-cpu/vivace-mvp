{
  "name": "vivace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43145",
    "predev": "npm run db:ready",
    "db:ready": "sh -c 'test -f .env || cp .env.example .env; node scripts/prisma-cli.mjs generate && node scripts/prisma-cli.mjs db push && tsx prisma/seed.ts'",
    "db:reset": "node scripts/prisma-cli.mjs db push --force-reset && tsx prisma/seed.ts",
    "build": "node scripts/prisma-cli.mjs generate && next build",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "db:migrate-postgres": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "uploads:migrate-bucket": "tsx scripts/migrate-uploads-to-bucket.ts",
    "start": "sh -c 'next start --hostname 0.0.0.0 --port ${PORT:-43145}'",
    "start:prod": "npm run db:ready && npm start",
    "lint": "eslint",
    "postinstall": "node scripts/prisma-cli.mjs generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@base-ui/react": "^1.8.0",
    "@prisma/client": "6.16.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "imapflow": "^1.0.164",
    "jszip": "^3.10.1",
    "lucide-react": "^1.41.0",
    "mailparser": "^3.7.2",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "prisma": "6.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jszip": "^3.4.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
